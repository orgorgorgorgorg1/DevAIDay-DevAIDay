@model IReadOnlyCollection<Microsoft.eShopWeb.Web.ViewModels.CatalogItemViewModel>

@if (Model.Any())
{
    <section class="container mt-4">
        <div class="row">
            <div class="col-12">
                <h2 class="h3 text-uppercase">Featured products</h2>
            </div>
        </div>
        <div class="row">
            @foreach (var catalogItem in Model)
            {
                <div class="col-12 col-md-4 mb-4">
                    <form asp-page="/Basket/Index" method="post" class="text-center">
                        <img class="esh-catalog-thumbnail" src="@catalogItem.PictureUri" alt="@catalogItem.Name" />
                        <input class="esh-catalog-button" type="submit" value="Shop now" />
                        <div class="esh-catalog-name">
                            <span>@catalogItem.Name</span>
                        </div>
                        <div class="h3 font-weight-bold text-center">
                            <span>@catalogItem.Price.ToString("C")</span>
                        </div>
                        <input type="hidden" name="id" value="@catalogItem.Id" />
                        <input type="hidden" name="name" value="@catalogItem.Name" />
                        <input type="hidden" name="pictureUri" value="@catalogItem.PictureUri" />
                        <input type="hidden" name="price" value="@catalogItem.Price" />
                    </form>
                </div>
            }
        </div>
    </section>
}
